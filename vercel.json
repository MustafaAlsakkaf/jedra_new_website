{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"No dependencies to install\"",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/projects",
      "destination": "/properties/",
      "permanent": true
    },
    {
      "source": "/projects/:path(.*)",
      "destination": "/properties/:path",
      "permanent": true
    },
    {
      "source": "/en/projects",
      "destination": "/en/properties/",
      "permanent": true
    },
    {
      "source": "/en/projects/:path(.*)",
      "destination": "/en/properties/:path",
      "permanent": true
    },
    {
      "source": "/ar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/:path(.*)",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/bonsai",
      "destination": "/properties/bonsai/",
      "permanent": false
    },
    {
      "source": "/hoksen",
      "destination": "/properties/hoksen/",
      "permanent": false
    },
    {
      "source": "/en/bonsai",
      "destination": "/en/properties/bonsai/",
      "permanent": false
    },
    {
      "source": "/en/hoksen",
      "destination": "/en/properties/hoksen/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(styles.css|main.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
